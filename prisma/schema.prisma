// Prisma Migrate owns the `public` schema (spec 0001). Data model: spec 0002.
// Every table gets RLS enabled, with no policies, in the migration that creates it.
// CHECK constraints live as raw SQL in the migrations (Prisma cannot express them),
// so read the migration too before trusting a column's range.
// Conventions: UUID v7 ids, `@db.Timestamptz(3)` on every DateTime (Prisma's default drops
// the time zone), tables and columns snake_case via @@map/@map, money as Int cents.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Product {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String        @unique
  description     String        @default("")
  status          ProductStatus @default(draft)
  featured        Boolean       @default(false)
  position        Int           @default(0)
  weightGrams     Int?          @map("weight_grams")
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  optionTypes ProductOptionType[]
  variants    ProductVariant[]
  categories  ProductCategory[]
  images      ProductImage[]

  @@index([status, position])
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(uuid(7)) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  sku                 String   @unique
  priceCents          Int      @map("price_cents")
  compareAtPriceCents Int?     @map("compare_at_price_cents")
  stockQuantity       Int      @default(0) @map("stock_quantity")
  archived            Boolean  @default(false)
  position            Int
  // Sorted option value ids joined with ","; "" for a product's default variant.
  // The catalog action keeps it in step with variant_option_values in the same transaction.
  optionKey           String   @map("option_key")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  cartItems    CartItem[]

  // Also serves as the product_id FK index.
  @@unique([productId, optionKey])
  @@map("product_variants")
}

model ProductOptionType {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  // Also serves as the product_id FK index.
  @@unique([productId, name])
  @@map("product_option_types")
}

model ProductOptionValue {
  id           String @id @default(uuid(7)) @db.Uuid
  optionTypeId String @map("option_type_id") @db.Uuid
  value        String
  position     Int

  optionType ProductOptionType    @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  variants   VariantOptionValue[]
  images     ProductImage[]

  // Also serves as the option_type_id FK index.
  @@unique([optionTypeId, value])
  @@map("product_option_values")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // NoAction: an option value still used by a variant cannot be deleted on its own.
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: NoAction)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model Category {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String   @unique
  description     String?
  visible         Boolean  @default(true)
  position        Int
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductCategory[]

  @@index([visible, position])
  @@map("categories")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  position   Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

model ProductImage {
  id            String   @id @default(uuid(7)) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  storagePath   String   @unique @map("storage_path")
  altText       String   @default("") @map("alt_text")
  position      Int
  width         Int?
  height        Int?
  // Set when the image belongs to one option value (e.g. the red photos of a tee).
  optionValueId String?  @map("option_value_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([optionValueId])
  @@map("product_images")
}

// ─── People and cart ────────────────────────────────────────────────────────

// id is the Supabase auth user id (no FK into `auth`, spec 0001). Admins are disabled via
// disabled_at, never deleted, so the actor on order events and refunds never breaks.
model AdminUser {
  id         String    @id @db.Uuid
  email      String    @unique
  name       String
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_users")
}

// id is the Supabase auth user id (no FK into `auth`, spec 0001).
model Customer {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses CustomerAddress[]
  cart      Cart?

  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid(7)) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  fullName    String   @map("full_name")
  line1       String
  line2       String?
  city        String
  postalCode  String   @map("postal_code")
  countryCode String   @map("country_code") @db.Char(2)
  phone       String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // At most one default address per customer.
  @@unique([customerId], map: "customer_addresses_one_default_key", where: raw("is_default"))
  @@index([customerId])
  @@map("customer_addresses")
}

model Cart {
  id         String   @id @default(uuid(7)) @db.Uuid
  // Unique but nullable: one cart per customer, any number of guest carts.
  customerId String?  @unique @map("customer_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Also serves as the cart_id FK index.
  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ─── Operations ─────────────────────────────────────────────────────────────

// A single row (id 1), inserted by the migration.
model StoreSettings {
  id                         Int      @id @default(1)
  flatShippingCents          Int      @default(0) @map("flat_shipping_cents")
  freeShippingThresholdCents Int?     @map("free_shipping_threshold_cents")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}
