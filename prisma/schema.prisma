// Prisma Migrate owns the `public` schema (spec 0001). Data model: spec 0002.
// Every table gets RLS enabled, with no policies, in the migration that creates it.
// CHECK constraints live as raw SQL in the migrations (Prisma cannot express them),
// so read the migration too before trusting a column's range.
// Conventions: UUID v7 ids, `@db.Timestamptz(3)` on every DateTime (Prisma's default drops
// the time zone), tables and columns snake_case via @@map/@map, money as Int cents.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  draft
  active
  archived

  @@map("product_status")
}

enum OrderStatus {
  pending_payment
  paid
  shipped
  delivered
  cancelled
  expired

  @@map("order_status")
}

enum OrderEventType {
  created
  status_changed
  refund_created
  refund_succeeded
  refund_failed
  stock_shortfall
  note

  @@map("order_event_type")
}

enum ActorType {
  admin
  system
  customer

  @@map("actor_type")
}

enum RefundStatus {
  pending
  succeeded
  failed

  @@map("refund_status")
}

enum DiscountType {
  percent
  fixed_amount

  @@map("discount_type")
}

enum EmailKind {
  order_confirmation
  order_shipped
  order_refunded

  @@map("email_kind")
}

enum EmailSendStatus {
  pending
  sent
  failed

  @@map("email_send_status")
}

// ─── Catalog ────────────────────────────────────────────────────────────────

model Product {
  id              String        @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String        @unique
  description     String        @default("")
  status          ProductStatus @default(draft)
  featured        Boolean       @default(false)
  position        Int           @default(0)
  weightGrams     Int?          @map("weight_grams")
  metaTitle       String?       @map("meta_title")
  metaDescription String?       @map("meta_description")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  optionTypes ProductOptionType[]
  variants    ProductVariant[]
  categories  ProductCategory[]
  images      ProductImage[]
  orderLines  OrderLine[]

  @@index([status, position])
  @@map("products")
}

model ProductVariant {
  id                  String   @id @default(uuid(7)) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  sku                 String   @unique
  priceCents          Int      @map("price_cents")
  compareAtPriceCents Int?     @map("compare_at_price_cents")
  stockQuantity       Int      @default(0) @map("stock_quantity")
  archived            Boolean  @default(false)
  position            Int
  // Sorted option value ids joined with ","; "" for a product's default variant.
  // The catalog action keeps it in step with variant_option_values in the same transaction.
  optionKey           String   @map("option_key")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product      Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues VariantOptionValue[]
  cartItems    CartItem[]
  orderLines   OrderLine[]

  // Also serves as the product_id FK index.
  @@unique([productId, optionKey])
  @@map("product_variants")
}

model ProductOptionType {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  name      String
  position  Int

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  // Also serves as the product_id FK index.
  @@unique([productId, name])
  @@map("product_option_types")
}

model ProductOptionValue {
  id           String @id @default(uuid(7)) @db.Uuid
  optionTypeId String @map("option_type_id") @db.Uuid
  value        String
  position     Int

  optionType ProductOptionType    @relation(fields: [optionTypeId], references: [id], onDelete: Cascade)
  variants   VariantOptionValue[]
  images     ProductImage[]

  // Also serves as the option_type_id FK index.
  @@unique([optionTypeId, value])
  @@map("product_option_values")
}

model VariantOptionValue {
  variantId     String @map("variant_id") @db.Uuid
  optionValueId String @map("option_value_id") @db.Uuid

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  // NoAction: an option value still used by a variant cannot be deleted on its own.
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: NoAction)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
  @@map("variant_option_values")
}

model Category {
  id              String   @id @default(uuid(7)) @db.Uuid
  name            String
  slug            String   @unique
  description     String?
  visible         Boolean  @default(true)
  position        Int
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  products ProductCategory[]

  @@index([visible, position])
  @@map("categories")
}

model ProductCategory {
  productId  String @map("product_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  position   Int

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, position])
  @@map("product_categories")
}

model ProductImage {
  id            String   @id @default(uuid(7)) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  storagePath   String   @unique @map("storage_path")
  altText       String   @default("") @map("alt_text")
  position      Int
  width         Int?
  height        Int?
  // Set when the image belongs to one option value (e.g. the red photos of a tee).
  optionValueId String?  @map("option_value_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)

  @@index([productId, position])
  @@index([optionValueId])
  @@map("product_images")
}

// ─── People and cart ────────────────────────────────────────────────────────

// id is the Supabase auth user id (no FK into `auth`, spec 0001). Admins are disabled via
// disabled_at, never deleted, so the actor on order events and refunds never breaks.
model AdminUser {
  id         String    @id @db.Uuid
  email      String    @unique
  name       String
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderEvents OrderEvent[]
  refunds     Refund[]

  @@map("admin_users")
}

// id is the Supabase auth user id (no FK into `auth`, spec 0001).
model Customer {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses CustomerAddress[]
  cart      Cart?
  orders    Order[]

  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid(7)) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  fullName    String   @map("full_name")
  line1       String
  line2       String?
  city        String
  postalCode  String   @map("postal_code")
  countryCode String   @map("country_code") @db.Char(2)
  phone       String?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // At most one default address per customer.
  @@unique([customerId], map: "customer_addresses_one_default_key", where: raw("is_default"))
  @@index([customerId])
  @@map("customer_addresses")
}

model Cart {
  id         String   @id @default(uuid(7)) @db.Uuid
  // Unique but nullable: one cart per customer, any number of guest carts.
  customerId String?  @unique @map("customer_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CartItem[]
  orders   Order[]

  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid(7)) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  // Also serves as the cart_id FK index.
  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("cart_items")
}

// ─── Orders and money ───────────────────────────────────────────────────────

// Everything about what was bought is a snapshot taken at checkout: nothing about an order is
// read from live catalog rows. The totals CHECKs live in the migration.
model Order {
  id                      String        @id @default(uuid(7)) @db.Uuid
  // Assigned by the database, starting at 1001 (the migration sets the sequence start).
  number                  Int           @unique @default(autoincrement())
  status                  OrderStatus   @default(pending_payment)
  needsAttention          Boolean       @default(false) @map("needs_attention")
  customerId              String?       @map("customer_id") @db.Uuid
  cartId                  String?       @map("cart_id") @db.Uuid
  email                   String
  customerName            String?       @map("customer_name")
  phone                   String?
  shipFullName            String?       @map("ship_full_name")
  shipLine1               String?       @map("ship_line1")
  shipLine2               String?       @map("ship_line2")
  shipCity                String?       @map("ship_city")
  shipPostalCode          String?       @map("ship_postal_code")
  shipCountryCode         String?       @map("ship_country_code") @db.Char(2)
  currency                String        @db.Char(3)
  subtotalCents           Int           @map("subtotal_cents")
  discountCents           Int           @default(0) @map("discount_cents")
  shippingCents           Int           @default(0) @map("shipping_cents")
  // Tax contained in total_cents (prices are tax inclusive), never added to it.
  taxCents                Int?          @map("tax_cents")
  totalCents              Int           @map("total_cents")
  // Sum of succeeded refunds, kept in step by the refund action in the same transaction.
  refundedCents           Int           @default(0) @map("refunded_cents")
  discountCodeId          String?       @map("discount_code_id") @db.Uuid
  discountCode            String?       @map("discount_code")
  discountType            DiscountType? @map("discount_type")
  discountValue           Int?          @map("discount_value")
  stripeCheckoutSessionId String?       @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?       @unique @map("stripe_payment_intent_id")
  trackingNumber          String?       @map("tracking_number")
  carrier                 String?
  paidAt                  DateTime?     @map("paid_at") @db.Timestamptz(3)
  shippedAt               DateTime?     @map("shipped_at") @db.Timestamptz(3)
  deliveredAt             DateTime?     @map("delivered_at") @db.Timestamptz(3)
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  expiredAt               DateTime?     @map("expired_at") @db.Timestamptz(3)
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer   Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cart       Cart?               @relation(fields: [cartId], references: [id], onDelete: SetNull)
  discount   DiscountCode?       @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  lines      OrderLine[]
  events     OrderEvent[]
  refunds    Refund[]
  redemption DiscountRedemption?
  emailSends EmailSend[]

  // One pending order per cart, so paying twice for one cart is impossible.
  @@unique([cartId], map: "orders_one_pending_per_cart_key", where: raw("status = 'pending_payment'::order_status"))
  @@index([status, createdAt])
  @@index([paidAt])
  @@index([email])
  @@index([customerId])
  @@index([cartId])
  @@index([discountCodeId])
  @@map("orders")
}

model OrderLine {
  id             String   @id @default(uuid(7)) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  // Links back to the catalog are a convenience; they go null if the row is ever hard deleted.
  variantId      String?  @map("variant_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  productName    String   @map("product_name")
  variantLabel   String?  @map("variant_label")
  sku            String
  imagePath      String?  @map("image_path")
  unitPriceCents Int      @map("unit_price_cents")
  quantity       Int
  discountCents  Int      @default(0) @map("discount_cents")
  lineTotalCents Int      @map("line_total_cents")
  taxCents       Int?     @map("tax_cents")
  taxRateBps     Int?     @map("tax_rate_bps")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  refundLines RefundLine[]

  @@index([orderId])
  @@index([variantId])
  @@index([productId])
  @@map("order_lines")
}

model OrderEvent {
  id         String         @id @default(uuid(7)) @db.Uuid
  orderId    String         @map("order_id") @db.Uuid
  type       OrderEventType
  fromStatus OrderStatus?   @map("from_status")
  toStatus   OrderStatus?   @map("to_status")
  actorType  ActorType      @map("actor_type")
  // Required exactly when actor_type = admin (CHECK in the migration).
  adminId    String?        @map("admin_id") @db.Uuid
  message    String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@index([adminId])
  @@map("order_events")
}

model Refund {
  id             String       @id @default(uuid(7)) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  amountCents    Int          @map("amount_cents")
  reason         String?
  status         RefundStatus @default(pending)
  stripeRefundId String?      @unique @map("stripe_refund_id")
  actorType      ActorType    @map("actor_type")
  // Required exactly when actor_type = admin (CHECK in the migration).
  adminId        String?      @map("admin_id") @db.Uuid
  succeededAt    DateTime?    @map("succeeded_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  admin AdminUser?   @relation(fields: [adminId], references: [id], onDelete: Restrict)
  lines RefundLine[]

  @@index([orderId])
  @@index([succeededAt])
  @@index([adminId])
  @@map("refunds")
}

model RefundLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  refundId    String  @map("refund_id") @db.Uuid
  orderLineId String  @map("order_line_id") @db.Uuid
  quantity    Int
  restocked   Boolean @default(false)

  refund    Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderLine OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)

  // Also serves as the refund_id FK index.
  @@unique([refundId, orderLineId])
  @@index([orderLineId])
  @@map("refund_lines")
}

// Codes are uppercased by Zod before any write; a CHECK in the migration enforces it.
model DiscountCode {
  id               String       @id @default(uuid(7)) @db.Uuid
  code             String       @unique
  type             DiscountType
  // Percent (1 to 100) or an amount in cents, depending on type.
  value            Int
  startsAt         DateTime?    @map("starts_at") @db.Timestamptz(3)
  endsAt           DateTime?    @map("ends_at") @db.Timestamptz(3)
  maxRedemptions   Int?         @map("max_redemptions")
  perCustomerLimit Int?         @map("per_customer_limit")
  minSubtotalCents Int?         @map("min_subtotal_cents")
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders      Order[]
  redemptions DiscountRedemption[]

  @@map("discount_codes")
}

// One use of a code by one order. Inserted at checkout start under a FOR UPDATE lock on the
// code row (spec 0002, State transitions); deleted when a pending order expires or is cancelled.
model DiscountRedemption {
  id             String   @id @default(uuid(7)) @db.Uuid
  discountCodeId String   @map("discount_code_id") @db.Uuid
  orderId        String   @unique @map("order_id") @db.Uuid
  email          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Also serves as the discount_code_id FK index.
  @@index([discountCodeId, email])
  @@map("discount_redemptions")
}

// ─── Operations ─────────────────────────────────────────────────────────────

// A single row (id 1), inserted by the migration.
model StoreSettings {
  id                         Int      @id @default(1)
  flatShippingCents          Int      @default(0) @map("flat_shipping_cents")
  freeShippingThresholdCents Int?     @map("free_shipping_threshold_cents")
  updatedAt                  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}

// One row per Stripe event handled; inserting it in the same transaction as its effect makes
// a replayed webhook a unique violation instead of a second effect.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@map("stripe_events")
}

// dedupe_key: `order_confirmation:<orderId>`, `order_shipped:<orderId>` or
// `order_refunded:<refundId>`; also sent to Resend as the idempotency key.
model EmailSend {
  id        String          @id @default(uuid(7)) @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  kind      EmailKind
  dedupeKey String          @unique @map("dedupe_key")
  status    EmailSendStatus @default(pending)
  resendId  String?         @map("resend_id")
  sentAt    DateTime?       @map("sent_at") @db.Timestamptz(3)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("email_sends")
}
