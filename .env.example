# Copy to .env.local for local development. Never commit real values.
# Local values for the Supabase stack come from `pnpm exec supabase status`.

# Database (Prisma). Runtime uses the pooler in transaction mode; migrations use the direct connection.
DATABASE_URL=
DIRECT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cart cookie signing (at least 32 characters, e.g. `openssl rand -base64 32`)
CART_COOKIE_SECRET=

# Store
NEXT_PUBLIC_SITE_URL=
STORE_CURRENCY=
STORE_TIMEZONE=

# Payments (feature 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (feature 11)
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron
CRON_SECRET=
