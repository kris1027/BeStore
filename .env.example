# Copy to .env.local for local development. Never commit real values.
# Local values for the Supabase stack come from `pnpm exec supabase status`.

# Database (Prisma). Runtime uses the pooler in transaction mode; migrations use the direct connection.
# Locally the Supabase pooler is off, so both point at the direct DB port 55322.
DATABASE_URL=
DIRECT_URL=
# Dedicated database that `pnpm test:db` migrates and truncates; never the dev database.
# Locally: create `bestore_test` once on the Supabase stack's Postgres, e.g.
# postgresql://postgres:postgres@127.0.0.1:55322/bestore_test
TEST_DATABASE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cart cookie signing (at least 32 characters, e.g. `openssl rand -base64 32`)
CART_COOKIE_SECRET=

# Store
NEXT_PUBLIC_SITE_URL=
STORE_CURRENCY=
STORE_TIMEZONE=
# BCP 47 language tag for the store's language and price and date formats (e.g. en, en-GB, pl-PL).
# Optional, defaults to en.
STORE_LOCALE=

# Set by Vercel on every deploy (production, preview, development). Leave empty locally.
# /style-guide returns 404 when it is production.
VERCEL_ENV=

# Payments (feature 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (feature 11)
RESEND_API_KEY=
EMAIL_FROM=

# Vercel Cron: at least 32 characters (openssl rand -hex 32). Vercel sends it to /api/cron/*.
CRON_SECRET=
