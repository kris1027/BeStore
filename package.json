{
  "name": "bestore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:db": "tsx scripts/test-db.ts",
    "test:stack": "vitest run --project stack",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate && simple-git-hooks",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:seed": "prisma db seed",
    "admin:create": "tsx scripts/admin/create.ts",
    "admin:disable": "tsx scripts/admin/disable.ts",
    "admin:reset-mfa": "tsx scripts/admin/reset-mfa.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "culori": "^4.0.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "lint-staged": "^17.5.1",
    "otpauth": "9.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "7.10.0",
    "simple-git-hooks": "^2.14.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=24"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,yaml,yml}": "prettier --write"
  }
}
